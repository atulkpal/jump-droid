rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auth flow: any authenticated user can read/write their own admin record
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // App config: any authenticated user can read; owners can write
    match /appConfig/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "owner";
    }

    // Campaign config: any authenticated user (admin) can read/write
    match /campaignConfig/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Testers + subcollections: Authenticated read; Authenticated write
    match /testers/{docId} {
      allow read, write: if request.auth != null;
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null;
      }
      match /feedback/{feedbackId} {
        allow read, write: if request.auth != null;
      }
    }

    // Collection group queries for sessions
    match /{path=**}/sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // Collection group for testerFeedback
    match /{path=**}/testerFeedback/{feedbackId} {
      allow read, write: if request.auth != null;
    }

    // Dashboard config: Authenticated read; admins write
    match /dashboardConfig/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Beta users: Authenticated create; admin list/delete
    match /betaUsers/{email} {
      allow read, create, update: if request.auth != null;
      allow list, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Recruitment contacts: Authenticated read/write; admin list/delete
    match /recruitmentContacts/{email} {
      allow read, create, update: if request.auth != null;
      allow list, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Email accounts: admins can read/write
    match /emailAccounts/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Email log: admins can read; writes via server-side
    match /emailLog/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Email audit: admins can read; writes via client audit service
    match /emailAuditLog/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Activity log: admin can read; Authenticated can create
    match /activityLog/{doc} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Email template overrides: admins can read/write
    match /emailTemplateOverrides/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Custom email templates: admins can read/write
    match /emailTemplatesCustom/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Sender profiles: admins can read; writes via server-side
    match /senderProfiles/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Gmail auth tokens: no client access
    match /gmailAuth/{doc} {
      allow read, write: if false;
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
